{
  "name": "@ankhorage/paradox",
  "version": "0.3.3",
  "description": "Deterministic documentation generator for TypeScript packages.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/ankhorage/paradox#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/paradox/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/paradox.git"
  },
  "keywords": [
    "ankhorage",
    "developer-tools",
    "documentation",
    "readme-generator",
    "static-analysis",
    "ts-morph",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities/index.d.ts",
      "import": "./dist/capabilities/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "bin": {
    "paradox": "./dist/cli/standalone.js"
  },
  "ankh": {
    "category": "docs",
    "provider": "./dist/cli/index.js",
    "capabilities": [
      {
        "id": "docs.generate",
        "owner": "@ankhorage/paradox",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Generate documentation",
        "description": "Generate deterministic package documentation."
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "docs": "bun src/cli/standalone.ts",
    "docs:bunx": "bunx @ankhorage/paradox",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "prepack": "bun run build",
    "test": "bun test --path-ignore-patterns '**/*.e2e.test.ts'",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json",
    "version-packages": "ankhorage-changeset version",
    "knip:check": "ankhorage-knip",
    "test:standalone": "bun run build && bun test tests/cli.e2e.test.ts tests/capabilities.public-import.test.ts"
  },
  "dependencies": {
    "@ankhorage/ankh": "^0.13.0",
    "@ankhorage/capability": "^0.2.1",
    "@ankhorage/contracts": "^25.0.1",
    "@ankhorage/rules": "^0.2.0",
    "@ankhorage/rules-documentation": "^0.3.4",
    "@ankhorage/utility": "^1.9.63",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@ankhorage/devtools": "^2.3.10",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.4.3"
}
