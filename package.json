{
  "name": "@ankhorage/paradox",
  "version": "0.1.24",
  "description": "Deterministic documentation generator for TypeScript packages.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/ankhorage/paradox#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/paradox/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/paradox.git"
  },
  "keywords": [
    "typescript",
    "documentation",
    "readme-generator",
    "static-analysis",
    "ts-morph",
    "developer-tools"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "bin": {
    "paradox": "./dist/cli/standalone.js"
  },
  "ankh": {
    "category": "docs",
    "provider": "./dist/cli/index.js",
    "capabilities": [
      "docs.generate"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "docs": "bun src/cli/standalone.ts",
    "docs:bunx": "bunx @ankhorage/paradox",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json",
    "version-packages": "ankhorage-changeset version",
    "knip:check": "ankhorage-knip"
  },
  "dependencies": {
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@ankhorage/devtools": "^1.10.4",
    "@types/bun": "^1.4.0",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.4.0"
}
